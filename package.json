{
  "name": "@prjct.app/pi-memory",
  "version": "0.2.2",
  "description": "Pi-native temporal memory and hybrid retrieval for agents.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent-memory",
    "rag",
    "vector-search",
    "local-first"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-memory/main/docs/cover.png"
  },
  "exports": {
    ".": "./index.ts",
    "./vector": "./src/vector/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./sources": "./src/sources/index.ts"
  },
  "scripts": {
    "build": "rm -rf build && mkdir -p build && npm pack --ignore-scripts --pack-destination build >/dev/null && tar -xzf build/*.tgz -C build --strip-components=1 && rm -f build/*.tgz",
    "check": "tsc --noEmit && npm run check:immutable",
    "check:immutable": "node --import tsx scripts/check-immutable.ts",
    "test": "node --import ./tests/isolate.mjs --import tsx --test --test-concurrency=4 tests/*.test.ts",
    "test:integration": "node --import ./tests/isolate.mjs --import tsx --test tests/integration/*.test.ts",
    "eval": "node --import tsx scripts/eval.ts",
    "eval:real": "node --import tsx scripts/eval-real.ts",
    "bench": "node --import tsx scripts/bench.ts",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "eval:freshness": "node --import tsx scripts/eval-freshness-real.ts",
    "daemon": "node --import tsx scripts/memory-daemon.ts",
    "eval:curated": "node --import tsx scripts/eval-curated.ts",
    "eval:oracles": "node --import tsx scripts/eval-oracles.ts",
    "eval:compare": "node --import tsx scripts/eval-compare.ts",
    "build:pi": "node scripts/build-pi.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@prjct.app/pi-secrets": "^0.2.6",
    "@prjct.app/pi-tui-kit": "^0.3.4",
    "sqlite-vec": "0.1.9",
    "tsx": "^4.20.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.4",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-memory.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "scripts/memory-daemon.ts",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "overrides": {
    "adm-zip": "^0.6.1",
    "sharp": "^0.35.4"
  },
  "piBuild": {
    "entries": [
      "index.ts",
      "scripts/memory-daemon.ts"
    ],
    "external": [
      "@huggingface/transformers",
      "sqlite-vec",
      "@prjct.app/pi-secrets/privacy"
    ],
    "standalone": [
      "scripts/memory-daemon.ts"
    ]
  }
}
