{
  "name": "@prjct.app/pi-memory",
  "version": "0.3.1",
  "description": "Pi extension: searchable session history \u2014 what compaction removed and earlier sessions \u2014 read by id or date. Adds one on-demand tool.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent-memory",
    "session-history",
    "compaction",
    "sqlite-fts5"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-memory/main/docs/cover.png"
  },
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "build": "rm -rf build && mkdir -p build && npm pack --ignore-scripts --pack-destination build >/dev/null && tar -xzf build/*.tgz -C build --strip-components=1 && rm -f build/*.tgz",
    "check": "tsc --noEmit && npm run check:immutable",
    "check:immutable": "node --import tsx scripts/check-immutable.ts",
    "test": "export PI_CODING_AGENT_DIR=\"$(mktemp -d)\" PRJCT_HOME=\"$(mktemp -d)\" && node --import ./tests/isolate.mjs --import tsx --test --test-concurrency=4 tests/*.test.ts",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "build:pi": "node scripts/build-pi.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.4",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-memory.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "piBuild": {
    "entries": [
      "index.ts"
    ],
    "external": []
  }
}
